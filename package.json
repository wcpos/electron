{
	"name": "@wcpos/app-electron",
	"license": "MIT",
	"productName": "WCPOS",
	"version": "1.10.0",
	"description": "WCPOS desktop client",
	"author": "Paul Kilmurray <paul@wcpos.com>",
	"packageManager": "pnpm@10.31.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"electron",
			"rxdb-premium"
		]
	},
	"main": ".webpack/main",
	"scripts": {
		"postinstall": "node scripts/patch-rxdb-premium-resurrection-leak.mjs",
		"test:resurrection-patch": "node --test scripts/patch-rxdb-premium-resurrection-leak.test.mjs",
		"dev": "concurrently \"pnpm run dev:expo\" \"pnpm run dev:electron\"",
		"dev:expo": "ELECTRON=true EXPO_NO_METRO_LAZY=true BROWSER=none pnpm --filter @wcpos/main dev --web --port ${EXPO_PORT:-8088} --clear",
		"dev:electron": "NODE_ENV=\"development\" electron-forge start --enable-logging",
		"rebuild:all": "electron-rebuild -f -o usb",
		"package": "node scripts/patch-rxdb-premium-resurrection-leak.mjs && DEBUG=electron-osx-sign* electron-forge package",
		"make": "node scripts/patch-rxdb-premium-resurrection-leak.mjs && electron-forge make",
		"publish-app": "node scripts/patch-rxdb-premium-resurrection-leak.mjs && electron-forge publish",
		"lint": "eslint src --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
		"test": "pnpm run test:resurrection-patch && pnpm run test:axios && pnpm run test:preload && pnpm run test:novu && pnpm run test:printer-discovery && pnpm run test:winspool-printer && pnpm run test:rxdb-ipc-attachments && pnpm run test:image-cache && pnpm run test:external-window-isolation && pnpm run test:package-runtime-externals && pnpm run test:bluetooth-select && pnpm run test:device-select && pnpm run test:serial-printer && pnpm run test:raw-print && pnpm run test:boot && pnpm run test:opfs-recovery && pnpm run test:storage-measure",
		"ts:check": "tsc --noEmit",
		"test:axios": "ts-node src/main/axios.test.ts",
		"test:preload": "ts-node src/preload.test.ts",
		"test:novu": "ts-node src/main/novu.test.ts",
		"test:rxdb-ipc-attachments": "ts-node src/rxdb-ipc-attachments.test.ts",
		"test:image-cache": "ts-node src/main/image-cache.test.ts",
		"test:storage-measure": "ts-node src/main/storage-measure.test.ts",
		"test:external-window-isolation": "ts-node src/main/external-window-isolation.test.ts",
		"test:printer-discovery": "ts-node src/main/printer-discovery.test.ts",
		"test:winspool-printer": "ts-node src/main/winspool-printer.test.ts",
		"test:package-runtime-externals": "ts-node --transpile-only test/package-runtime-externals.test.ts",
		"test:bluetooth-select": "ts-node src/main/bluetooth-select.test.ts",
		"test:device-select": "ts-node src/main/device-select.test.ts",
		"test:serial-printer": "ts-node src/main/serial-printer.test.ts",
		"test:raw-print": "ts-node src/main/raw-print.test.ts",
		"test:boot": "ts-node src/main/boot.test.ts",
		"test:opfs-recovery": "node --test src/main/opfs-targeted-recovery.cleanup.test.mjs src/main/opfs-targeted-recovery.test.mjs"
	},
	"dependencies": {
		"@novu/js": "3.19.0",
		"@sentry/electron": "^7.16.0",
		"@wcpos/printer": "workspace:*",
		"axios": "^1.19.0",
		"bonjour-service": "1.4.4",
		"electron-log": "^5.4.4",
		"electron-serve": "^3.0.1",
		"i18next": "^26.3.6",
		"rxdb": "17.4.0",
		"rxdb-premium": "17.4.0",
		"rxjs": "7.8.2",
		"semver": "^7.8.5",
		"serialport": "13.0.0",
		"usb": "2.18.0"
	},
	"devDependencies": {
		"@electron-forge/cli": "^7.11.2",
		"@electron-forge/maker-deb": "^7.11.2",
		"@electron-forge/maker-dmg": "^7.11.2",
		"@electron-forge/maker-flatpak": "^7.11.2",
		"@electron-forge/maker-rpm": "^7.11.2",
		"@electron-forge/maker-squirrel": "^7.11.2",
		"@electron-forge/maker-zip": "^7.11.2",
		"@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
		"@electron-forge/plugin-webpack": "^7.11.2",
		"@electron-forge/publisher-github": "^7.11.2",
		"@electron-forge/shared-types": "^7.11.2",
		"@electron/rebuild": "^4.2.0",
		"@types/fs-extra": "^11.0.4",
		"@types/webpack-node-externals": "^3.0.4",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"@vercel/webpack-asset-relocator-loader": "1.11.0",
		"@wcpos/eslint-config": "^2.2.0",
		"concurrently": "^10.0.5",
		"electron": "43.4.0",
		"electron-debug": "^4.1.0",
		"electron-devtools-installer": "4.0.0",
		"electron-squirrel-startup": "^1.0.1",
		"electron-store": "^11.0.2",
		"eslint": "^9.39.5",
		"fs-extra": "^11.4.0",
		"node-loader": "^2.1.0",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"typescript": "6.0.3"
	}
}
